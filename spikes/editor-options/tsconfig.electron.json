{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "electron-dist",
    "rootDir": ".",
    "types": [
      "node"
    ]
  },
  "include": [
    "electron/**/*.ts",
    "electron/**/*.cts",
    "src/contracts.ts",
    "src/persistence/file-store.ts"
  ]
}
