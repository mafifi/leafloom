{
  "name": "leafloom",
  "version": "1.3.5",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "dev": "pnpm --filter @leafloom/desktop dev",
    "build": "pnpm --filter @leafloom/desktop build",
    "check": "tsc --noEmit -p tsconfig.json && pnpm --filter @leafloom/desktop check",
    "test": "vitest run",
    "test:browser": "pnpm run test:neo-candidate",
    "check:ci": "pnpm run check:policy && pnpm run check && pnpm run test && pnpm run build",
    "check:policy": "node scripts/check-repository.mjs && pnpm run check:size",
    "tauri:build": "pnpm --filter @leafloom/desktop tauri build",
    "test:neo-candidate": "playwright test --config tests/neo-compat/candidate/playwright.config.ts",
    "check:parity": "node scripts/check-neo-parity.mjs",
    "format": "prettier --write apps/desktop/src packages/authoring/src packages/library/src",
    "test:neo-catchup": "playwright test --config tests/neo-compat/candidate/neo-1.3.5.config.ts",
    "test:neo-catchup-reference": "playwright test --config tests/neo-compat/reference/neo-1.3.5.config.ts",
    "check:size": "node scripts/check-file-size.mjs"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "jsdom": "catalog:",
    "@types/jsdom": "catalog:",
    "esbuild": "catalog:",
    "@tauri-apps/cli": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "pdfjs-dist": "catalog:",
    "jszip": "catalog:"
  }
}
